# Axon Frontend - environment variables
# Copy to `.env.local` and fill in real values. Never commit secrets.

# Supabase project (public anon key is safe for the browser; RLS protects data)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Axon backend — REST via Vite proxy in dev; WS direct to backend port 8010
VITE_API_BASE_URL=/api/v1
VITE_WS_URL=ws://127.0.0.1:8010/api/v1/ws

# Device link + gallery QR — live Vercel LinkPage (default for Vercel + Electron)
VITE_PUBLIC_MIRROR_URL=https://axon-smart-mirror.vercel.app

# LAN-only dev (optional — mirror + phone on same Wi-Fi, local :8010):
# VITE_DEVICE_LINK_LOCAL=true
# VITE_PUBLIC_MIRROR_URL=http://192.168.31.75:5173

# Electron desktop — set in axon-electron build only (optional override)
# VITE_VOICE_ENGINE=native

# Show intent debug overlay in VoiceCaptions (development only)
# VITE_DEBUG_VOICE=true
