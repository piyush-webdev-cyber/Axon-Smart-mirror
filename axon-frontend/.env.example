# Axon Frontend - environment variables
# Copy to `.env.local` and fill in real values. Never commit secrets.

# Supabase project (public anon key is safe for the browser; RLS protects data)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Axon backend — REST via Vite proxy in dev; WS direct to backend port 8010
VITE_API_BASE_URL=/api/v1
VITE_WS_URL=ws://127.0.0.1:8010/api/v1/ws

# Phone QR access — your PC's LAN IP so phones on the same Wi-Fi can scan gallery QR
# Example: VITE_PUBLIC_MIRROR_URL=http://192.168.1.5:5173
VITE_PUBLIC_MIRROR_URL=
