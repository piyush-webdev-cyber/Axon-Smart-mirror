# Axon Frontend - environment variables
# Copy to `.env.local` and fill in real values. Never commit secrets.

# Supabase project (public anon key is safe for the browser; RLS protects data)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Axon backend — REST via Vite proxy in dev; WS direct to backend port 8010
VITE_API_BASE_URL=/api/v1
VITE_WS_URL=ws://127.0.0.1:8010/api/v1/ws

# Production (Vercel) — see .env.production or set in Vercel dashboard:
# VITE_API_BASE_URL=https://axon-smart-mirror-production.up.railway.app/api/v1
# VITE_WS_URL=wss://axon-smart-mirror-production.up.railway.app/api/v1/ws
# VITE_PUBLIC_MIRROR_URL=https://axon-smart-mirror.vercel.app

# Phone QR access — dev: your PC LAN IP; prod: Vercel URL (see .env.production)
# Example: VITE_PUBLIC_MIRROR_URL=http://192.168.31.75:5173
VITE_PUBLIC_MIRROR_URL=

# Electron desktop — set in axon-electron build only (optional override)
# VITE_VOICE_ENGINE=native
