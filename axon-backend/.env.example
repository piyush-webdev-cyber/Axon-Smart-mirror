# Axon Backend - environment variables
# Copy to `.env` and fill in real values. Never commit secrets.

# App
AXON_ENV=development
AXON_DEBUG=true
AXON_API_PREFIX=/api/v1
AXON_VERSION=0.1.0

# CORS - comma-separated list of allowed origins (the mirror frontend)
# Can be comma-separated: http://localhost:5173,https://axon-smart-mirror.vercel.app
# Or JSON array: ["http://localhost:5173","https://axon-smart-mirror.vercel.app"]
AXON_CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://axon-smart-mirror.vercel.app

